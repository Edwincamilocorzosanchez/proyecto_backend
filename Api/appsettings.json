{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "GeneralRules": [
      {
        "Endpoint": "POST:/api/ordenesservicio",
        "Period": "1m",
        "Limit": 5,
        "Roles": ["Recepcionista"]
      },
      {
        "Endpoint": "PUT:/api/ordenesservicio",
        "Period": "1m",
        "Limit": 5,
        "Roles": ["Recepcionista"]
      },
      {
        "Endpoint": "DELETE:/api/ordenesservicio",
        "Period": "1m",
        "Limit": 5,
        "Roles": ["Recepcionista"]
      },
      {
        "Endpoint": "POST:/api/ordenesservicio",
        "Period": "1m",
        "Limit": 20,
        "Roles": ["Admin"]
      },
      {
        "Endpoint": "PUT:/api/ordenesservicio",
        "Period": "1m",
        "Limit": 20,
        "Roles": ["Admin"]
      },
      {
        "Endpoint": "DELETE:/api/ordenesservicio",
        "Period": "1m",
        "Limit": 20,
        "Roles": ["Admin"]
      },
      {
        "Endpoint": "POST:/api/repuestos",
        "Period": "1m",
        "Limit": 5,
        "Roles": ["Recepcionista"]
      },
      {
        "Endpoint": "PUT:/api/repuestos",
        "Period": "1m",
        "Limit": 5,
        "Roles": ["Recepcionista"]
      },
      {
        "Endpoint": "DELETE:/api/repuestos",
        "Period": "1m",
        "Limit": 5,
        "Roles": ["Recepcionista"]
      },
      {
        "Endpoint": "POST:/api/repuestos",
        "Period": "1m",
        "Limit": 20,
        "Roles": ["Admin"]
      },
      {
        "Endpoint": "PUT:/api/repuestos",
        "Period": "1m",
        "Limit": 20,
        "Roles": ["Admin"]
      },
      {
        "Endpoint": "DELETE:/api/repuestos",
        "Period": "1m",
        "Limit": 20,
        "Roles": ["Admin"]
      },
      {
        "Endpoint": "GET:/api/*",
        "Period": "1m",
        "Limit": 50
      }
    ]
  }
}
